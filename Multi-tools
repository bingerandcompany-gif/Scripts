selectAllBtn.MouseButton1Click:Connect(function()
    playButtonFeedback(selectAllBtn)
    for tool, data in pairs(toolButtons) do
        if not selectedTools[tool] then
            data.toggle()
        end
    end
    showNotification("All tools selected!", CONFIG.Theme.Accent)
end)

deselectAllBtn.MouseButton1Click:Connect(function()
    playButtonFeedback(deselectAllBtn)
    local toDeselect = {}
    for tool, _ in pairs(selectedTools) do
        table.insert(toDeselect, tool)
    end
    for _, tool in ipairs(toDeselect) do
        local data = toolButtons[tool]
        if data then
            data.toggle()
        end
    end
    showNotification("Selection cleared!", CONFIG.Theme.Danger)
end)

invertBtn.MouseButton1Click:Connect(function()
    playButtonFeedback(invertBtn)
    for tool, data in pairs(toolButtons) do
        data.toggle()
    end
    showNotification("Selection inverted!", CONFIG.Theme.Warning)
end)

