local function removeToolButton(tool)
    if toolButtons[tool] then
        toolButtons[tool].button:Destroy()
        selectedTools[tool] = nil
        toolButtons[tool] = nil
        updateCount()
    end
    
    if next(toolButtons) == nil then
        emptyLabel.Visible = true
    end
end

local function scanTools()
    for tool, data in pairs(toolButtons) do
        removeToolButton(tool)
    end
    
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then
            createToolButton(child)
        end
    end
    
    local char = player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                createToolButton(child)
            end
        end
    end
end

-- =============================================================================
-- ACTIVATION LOGIC
-- =============================================================================

local function activateAllSelected()
    if isProcessing then
        showNotification("Already processing!", CONFIG.Theme.Warning)
        return
    end
    
    local toolsToActivate = {}
    for tool, _ in pairs(selectedTools) do
        table.insert(toolsToActivate, tool)
    end
    
    if #toolsToActivate == 0 then
        showNotification("No tools selected!", CONFIG.Theme.Warning)
        return
    end
    
    isProcessing = true
    showNotification("Activating " .. #toolsToActivate .. " tools...", CONFIG.Theme.Accent)
    
    local originalTool = nil
    local char = player.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then
                originalTool = child
                break
            end
        end
    end
    
    task.spawn(function()
        for i, tool in ipairs(toolsToActivate) do
            if tool and tool.Parent then
                pcall(function()
                    local btnData = toolButtons[tool]
                    if btnData then
                        tween(btnData.button, {BackgroundColor3 = CONFIG.Theme.Success}, 0.05)
                    end
                    
                    humanoid:EquipTool(tool)
                    task.wait(0.03)
                    if tool.Enabled then
                        tool:Activate()
                    end
                    
                    if btnData then
                        task.delay(0.15, function()
                            if selectedTools[tool] then
                                tween(btnData.button, {BackgroundColor3 = Color3.fromRGB(55, 60, 90)}, 0.1)
                            else
                                tween(btnData.button, {BackgroundColor3 = CONFIG.Theme.Button}, 0.1)
                            end
                        end)
                    end
                    
                    task.wait(CONFIG.ActivationDelay)
                end)
            end
        end
        
        if originalTool and originalTool.Parent then
            pcall(function()
                task.wait(0.05)
                humanoid:EquipTool(originalTool)
            end)
        end
        
        isProcessing = false
        showNotification("All tools activated!", CONFIG.Theme.Success)
    end)
end

