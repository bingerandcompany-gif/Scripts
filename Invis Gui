-- Ant Life: Ultimate FE Invisibility (Non-Teleporting)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 1. Create the UI Button
local ScreenGui = Instance.new("ScreenGui", Player:WaitForChild("PlayerGui"))
ScreenGui.Name = "AntStealth"
ScreenGui.ResetOnSpawn = false

local Button = Instance.new("TextButton", ScreenGui)
Button.Size = UDim2.new(0, 150, 0, 50)
Button.Position = UDim2.new(0.05, 0, 0.4, 0)
Button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
Button.Text = "STEALTH: OFF"
Button.TextColor3 = Color3.new(1, 1, 1)
Button.Font = Enum.Font.SourceSansBold
Button.TextSize = 20

local isInvisible = false
local GhostModel = nil
local Connection = nil

-- 2. Logic to hide the character FE
local function toggleStealth()
    local RealChar = Player.Character
    if not RealChar or not RealChar:FindFirstChild("HumanoidRootPart") then return end
    
    isInvisible = not isInvisible
    
    if isInvisible then
        -- Create a "Ghost" version only you can see to move around
        RealChar.Archivable = true
        GhostModel = RealChar:Clone()
        GhostModel.Parent = workspace
        GhostModel.Name = "StealthGhost"
        
        -- Make the Ghost translucent for you so you know you're in stealth
        for _, p in pairs(GhostModel:GetDescendants()) do
            if p:IsA("BasePart") then p.Transparency = 0.5 p.CanCollide = false end
        end
        
        -- Hide the Real Ant from everyone else (FE Bypass)
        -- We parent it to a local folder; the server stops replicating it to others
        local HiddenFolder = Instance.new("Folder")
        HiddenFolder.Name = "HiddenAnt"
        RealChar.Parent = HiddenFolder
        
        -- Fix Movement: Point camera and controls to the Ghost
        Camera.CameraSubject = GhostModel:FindFirstChildWhichIsA("Humanoid")
        
        -- Sync Loop: Keeps your 'Real' hitbox at your Ghost's position
        -- This prevents the "teleport-kill" because coordinates update smoothly
        Connection = RunService.Heartbeat:Connect(function()
            if RealChar and GhostModel and RealChar:FindFirstChild("HumanoidRootPart") then
                RealChar.HumanoidRootPart.CFrame = GhostModel.HumanoidRootPart.CFrame
            end
        end)
        
        Button.Text = "STEALTH: ON"
        Button.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
    else
        -- Clean up and return to normal
        if Connection then Connection:Disconnect() end
        if GhostModel then
            local lastPos = GhostModel.HumanoidRootPart.CFrame
            GhostModel:Destroy()
            
            -- Bring the real character back to where the ghost stopped
            RealChar.Parent = workspace
            RealChar:PivotTo(lastPos)
            Camera.CameraSubject = RealChar:FindFirstChildWhichIsA("Humanoid")
        end
        
        Button.Text = "STEALTH: OFF"
        Button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end

Button.MouseButton1Click:Connect(toggleStealth)

-- Handle evolution/caste changes in Ant Life
Player.CharacterAdded:Connect(function()
    if isInvisible then
        toggleStealth() -- Force reset if you evolve/die
    end
end)
