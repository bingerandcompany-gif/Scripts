-- FE Invisibility Button Script for Ant Life
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()

-- 1. Create the GUI Toggle
local ScreenGui = Instance.new("ScreenGui", Player:WaitForChild("PlayerGui"))
ScreenGui.Name = "FE_Invis_Gui"
local Button = Instance.new("TextButton", ScreenGui)
Button.Size = UDim2.new(0, 150, 0, 50)
Button.Position = UDim2.new(0.05, 0, 0.4, 0)
Button.Text = "FE Invisible: OFF"
Button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
Button.TextColor3 = Color3.new(1, 1, 1)

local isInvisible = false
local GhostAnt = nil
local RealCharacter = nil

-- 2. Mimic Logic (The FE Bypass)
local function toggleFEInvisibility()
    RealCharacter = Player.Character
    if not RealCharacter or not RealCharacter:FindFirstChild("HumanoidRootPart") then return end

    isInvisible = not isInvisible
    
    if isInvisible then
        -- Step A: Create the "Ghost" ant for you to see and move
        RealCharacter.Archivable = true
        GhostAnt = RealCharacter:Clone()
        GhostAnt.Parent = workspace
        GhostAnt.Name = "GhostAnt_Local"
        
        -- Step B: Make the real ant "disappear" for others
        -- Parenting to nil is the standard FE bypass
        RealCharacter.Parent = nil 
        
        Button.Text = "FE Invisible: ON"
        Button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        -- Step C: Movement Loop (Ghost mimics your inputs)
        task.spawn(function()
            while isInvisible and GhostAnt do
                local root = GhostAnt:FindFirstChild("HumanoidRootPart")
                if root then
                    -- Keep your camera focused on the Ghost ant
                    workspace.CurrentCamera.CameraSubject = GhostAnt.Humanoid
                end
                task.wait()
            end
        end)
    else
        -- Step D: Re-emerge
        if GhostAnt then
            local lastPos = GhostAnt.HumanoidRootPart.CFrame
            GhostAnt:Destroy()
            
            -- Bring the real character back to the ghost's last location
            RealCharacter.Parent = workspace
            RealCharacter.HumanoidRootPart.CFrame = lastPos
            workspace.CurrentCamera.CameraSubject = RealCharacter.Humanoid
        end
        
        Button.Text = "FE Invisible: OFF"
        Button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    end
end

Button.MouseButton1Click:Connect(toggleFEInvisibility)

-- 3. Component Clean-up
-- Ensures that accessories and nametags don't "float"
local function hideResiduals(char)
    for _, item in pairs(char:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Decal") then
            if item.Name ~= "HumanoidRootPart" then item.Transparency = 1 end --
        elseif item:IsA("BillboardGui") then
            item.Enabled = false
        end
    end
end
